<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="fs25_fullScreenBackground"/>
    <Bitmap profile="fs25_tabListContainer" id="header">
        <MultiTextOption profile="uiInGameMenuHeaderSelector" onClick="onClickPageSelection" id="pageSelector" soundDisabled="true"/>
        <SmoothList profile="fs25_tabList" id="pagingTabList" onSelectionChanged="onTabMenuSelectionChanged" onScroll="onTabMenuScroll">
            <ListItem profile="fs25_tabListItem">
                <Button profile="fs25_tabListItemButton" name="tabButton"/>
                <Bitmap profile="fs25_tabListItemSeparator"/>
                <Bitmap profile="fs25_tabListItemSeparatorBottom"/>
            </ListItem>
        </SmoothList>
    </Bitmap>
    <Paging profile="uiInGameMenuPaging" onPageChange="onPageChange" onPageUpdate="onPageUpdate" id="pagingElement">
        <FrameReference ref="shopCategories" name="brands" id="pageShopBrands"/>
        <FrameReference ref="shopCategories" name="vehicles" id="pageShopVehicles"/>
        <FrameReference ref="shopCategories" name="packs" id="pageShopPacks"/>
        <FrameReference ref="shopItems" name="usedSale" id="pageUsedSale"/>
        <FrameReference ref="shopCategories" name="dlcs" id="pageShopDLCs"/>
        <FrameReference ref="shopCategories" name="dlcVehicles" id="pageShopDLCVehicles"/>
        <FrameReference ref="shopItems" name="itemDetails" id="pageShopItemDetails"/>
        <FrameReference ref="shopItems" name="itemCombinations" id="pageShopItemCombinations"/>
        <FrameReference ref="shopOthers" name="shopOthers" id="pageShopOthers"/>
    </Paging>
    <BoxLayout profile="fs25_buttonBox" id="buttonsPanel">
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[1]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[2]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[3]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[4]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[5]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
        <Button profile="buttonBack" onClick="onClickBack" id="menuButton[6]">
            <Bitmap profile="fs25_buttonBoxSeparator" name="separator"/>
        </Button>
    </BoxLayout>
    <GUIProfiles>
        <Profile name="shopMenuHeaderGlyphLeft" extends="baseReference" with="anchorMiddleRight">
            <size value="48px 48px"/>
            <position value="40px 0px"/>
            <isLeftAligned value="true"/>
            <inputAction value="MENU_PAGE_PREV"/>
            <glyphColor value="$preset_colorBlack"/>
        </Profile>
        <Profile name="shopMenuHeaderGlyphRight" extends="baseReference" with="anchorMiddleLeft">
            <size value="48px 48px"/>
            <position value="-40px 0px"/>
            <isLeftAligned value="true"/>
            <inputAction value="MENU_PAGE_NEXT"/>
            <glyphColor value="$preset_colorBlack"/>
        </Profile>
    </GUIProfiles>
</GUI>
