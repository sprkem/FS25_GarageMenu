<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="shopItems">
    <GuiElement profile="fs25_shopContainer">
        <GuiElement profile="fs25_shopHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="itemsHeaderIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="itemsHeaderText"/>
            <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg"/>
            <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
                <Bitmap profile="fs25_shopSlotsIcon" id="shopSlotsIcon"/>
                <Text profile="fs25_shopSlots" text="0 / 0" id="shopSlotsText"/>
                <Text profile="fs25_shopBalance" text="$l10n_ui_balance:"/>
                <Text profile="fs25_shopMoney" id="currentBalanceText"/>
            </BoxLayout>
        </GuiElement>
        <Text profile="ingameMenuNoContentText" text="$l10n_ui_noShopItems" id="noItemsText" position="-5px 105px"/>
        <GuiElement profile="fs25_shopItemsListContainer">
            <SmoothList profile="fs25_shopItemsList" id="itemsList" onDoubleClick="onOpenItem" startClipperElementName="startClipper" listSectionHeader="section">
                <ListItem profile="fs25_shopItemsListItem">
                    <Bitmap profile="fs25_shopItemsListItemBackground"/>
                    <Bitmap profile="fs25_shopItemsListItemSeparator"/>
                    <Bitmap profile="fs25_shopItemsListItemImage" name="icon"/>
                    <Bitmap profile="fs25_shopItemsListItemBrandImage" name="brandIcon" visible="false"/>
                    <ThreePartBitmap profile="fs25_shopItemsListItemPriceTag" name="priceTag" visible="false">
                        <Text profile="fs25_shopItemsListItemPriceTagText" name="priceTagText" text="0.99€"/>
                    </ThreePartBitmap>
                    <Text profile="fs25_shopItemsListItemTitleText" name="title"/>
                    <Text profile="fs25_shopItemsListItemValueText" name="value"/>
                    <Text profile="fs25_shopItemsListItemModDlcText" name="modDlc"/>
                </ListItem>
                <ListItem profile="fs25_shopItemsListSection" name="section"/>
                <ListItem profile="fs25_shopItemsListItem" name="empty">
                    <Bitmap profile="fs25_shopItemsListItemBackgroundEmpty"/>
                </ListItem>
            </SmoothList>
            <Bitmap profile="fs25_startClipper" name="startClipper" position="-2px 0px"/>
            <Bitmap profile="fs25_stopClipper" name="stopClipper" position="-2px 0px"/>
        </GuiElement>
        <GuiElement profile="fs25_shopItemsDetailsContainer" id="detailBox">
            <GuiElement profile="fs25_shopItemsDetailsContainerLeft">
                <Text profile="fs25_shopItemsDetailsName" id="itemDetailsName"/>
                <Text profile="fs25_shopItemsDetailsDescription" id="itemDetailsDescription"/>
            </GuiElement>
            <GuiElement profile="fs25_shopItemsDetailsContainerLeft" id="itemDetailsAmountBox">
                <Bitmap profile="fs25_shopItemsDetailsIconOwned"/>
                <Text profile="fs25_shopItemsDetailsIconText" id="itemDetailsOwned"/>
                <Bitmap profile="fs25_shopItemsDetailsIconLeased"/>
                <Text profile="fs25_shopItemsDetailsIconText" id="itemDetailsLeased" position="-20px -40px"/>
            </GuiElement>
            <Bitmap profile="fs25_itemDetailsFruitIcon" id="fruitIconTemplate" visible="false"/>
            <BoxLayout profile="fs25_shopItemsDetailsInfoBox" id="attributesLayout">
                <GuiElement profile="fs25_itemDetailsTemplateBox" name="detailTemplate">
                    <Bitmap profile="fs25_itemDetailsIcon" name="icon"/>
                    <Text profile="fs25_itemDetailsText" text="Default" name="text"/>
                </GuiElement>
                <GuiElement profile="fs25_itemDetailsTemplateBox" name="valueTemplate">
                    <Bitmap profile="shopListAttributeIconPrice" name="icon"/>
                    <Text profile="fs25_itemDetailsText" text="Dummy" name="text"/>
                </GuiElement>
                <GuiElement profile="fs25_itemDetailsFillTypeTemplateBox" name="fillTypesTemplate">
                    <Bitmap profile="fs25_itemDetailsFillTypeSeparator"/>
                    <Bitmap profile="fs25_itemDetailsIcon" name="icon"/>
                    <GuiElement profile="fs25_itemDetailsIconsLayoutBox">
                        <BoxLayout profile="fs25_itemDetailsIconsLayout" name="iconsLayout"/>
                    </GuiElement>
                </GuiElement>
            </BoxLayout>
        </GuiElement>
    </GuiElement>
    <ThreePartBitmap profile="fs25_sliderDockedBg">
        <ThreePartBitmap profile="fs25_sliderDockedBox">
            <Slider profile="fs25_sliderDocked" dataElementId="itemsList"/>
        </ThreePartBitmap>
    </ThreePartBitmap>
    <GUIProfiles>
        <Profile name="fs25_shopItemsDetailsContainer" extends="emptyPanel" with="anchorBottomStretchingX">
            <height value="225px"/>
            <visible value="false"/>
        </Profile>
        <Profile name="fs25_shopItemsDetailsContainerLeft" extends="emptyPanel" with="anchorStretchingYLeft">
            <width value="630px"/>
        </Profile>
        <Profile name="fs25_shopItemsDetailsIconOwned" extends="baseReference" with="anchorTopRight">
            <size value="35px 35px"/>
            <position value="-140px -40px"/>
            <imageSliceId value="gui.owned"/>
        </Profile>
        <Profile name="fs25_shopItemsDetailsIconLeased" extends="baseReference" with="anchorTopRight">
            <size value="35px 35px"/>
            <position value="-60px -40px"/>
            <imageSliceId value="gui.leased"/>
        </Profile>
        <Profile name="fs25_shopItemsDetailsIconText" extends="fs25_textDefault" with="anchorTopRight">
            <size value="40px 35px"/>
            <position value="-100px -40px"/>-            <textSize value="18px"/></Profile>
        <Profile name="fs25_shopItemsDetailsName" extends="fs25_textDefault" with="anchorTopLeft">
            <size value="64% 70px"/>
            <position value="20px -36px"/>
            <textSize value="32px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textMaxNumLines value="2"/>
            <textVerticalAlignment value="top"/>
        </Profile>
        <Profile name="fs25_shopItemsDetailsDescription" extends="fs25_textGrey">
            <size value="93.7% 70px"/>
            <position value="20px 35px"/>
            <textSize value="18px"/>
            <textMaxNumLines value="3"/>
            <textVerticalAlignment value="top"/>
        </Profile>
        <Profile name="fs25_shopItemsListContainer" extends="emptyPanel" with="anchorStretchingYStretchingX pivotTopCenter">
            <absoluteSizeOffset value="12px 220px"/>
            <position value="-6px -5px"/>
        </Profile>
        <Profile name="fs25_shopItemsList" extends="emptyPanel" with="anchorStretchingYStretchingX">
            <selectOnClick value="true"/>
            <showHighlights value="true"/>
            <numLateralItems value="5"/>
            <listItemSpacing value="-20px"/>
            <listItemLateralSpacing value="-25px"/>
        </Profile>
        <Profile name="fs25_shopItemsListItem" extends="emptyPanel" with="anchorTopLeft">
            <size value="308px 510px"/>
        </Profile>
        <Profile name="fs25_shopItemsListSection" extends="emptyPanel" with="anchorTopStretchingX">
            <height value="52px"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemBackground" extends="baseReference" with="anchorStretchingYStretchingX">
            <imageSliceId value="gui.vehicle_detail_box"/>
            <imageHighlightedSliceId value="gui.vehicle_detail_box_hover"/>
            <imageSelectedSliceId value="gui.vehicle_detail_box_selected"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemBackgroundEmpty" extends="baseReference" with="anchorStretchingYStretchingX">
            <imageSliceId value="gui.vehicle_detail_box"/>
            <imageColor value="1 1 1 0.25"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemSeparator" extends="baseReference" with="anchorBottomCenter">
            <size value="274px 1dp"/>
            <position value="1px 186px"/>
            <selectedOffset value="0px 17px"/>
            <imageColor value="$preset_fs25_colorGreyDark"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemImage" extends="baseReference" with="anchorTopCenter">
            <size value="280px 280px"/>
            <position value="0px 60px"/>
            <imageUVs value="0 0 1 1"/>
            <imageSliceId value="noSlice"/>
            <selectedOffset value="0px 15px"/>
            <Variant name="mobile">
                <position value="0px 40px"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsListItemImageWithoutBrand" extends="fs25_shopItemsListItemImage">
            <Variant name="mobile">
                <position value="0px -10px"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsListItemBrandImage" extends="fs25_shopItemsListItemImage">
            <size value="160px 80px"/>
            <position value="0px -230px"/>
            <imageSize value="256 128"/>
            <selectedOffset value="0px 15px"/>
            <Variant name="mobile" with="anchorBottomCenter">
                <size value="180px 90px"/>
                <position value="0px 90px"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsListItemPriceTag" extends="baseReference" with="anchorBottomRight">
            <size value="65px 30px"/>
            <position value="-25px 40px"/>
            <selectedOffset value="0px 15px"/>
            <imageSliceId value="gui.3dShop_button_middle"/>
            <imageColor value="$preset_fs25_colorMainHighlight"/>
            <imageSelectedColor value="$preset_fs25_colorMainDark"/>
            <startImageSize value="6px 0"/>
            <startImageSliceId value="gui.3dShop_button_left"/>
            <startImageSelectedColor value="$preset_fs25_colorMainDark"/>
            <endImageSize value="6px 0"/>
            <endImageSliceId value="gui.3dShop_button_right"/>
            <endImageSelectedColor value="$preset_fs25_colorMainDark"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemPriceTagText" extends="fs25_textDefault" with="anchorMiddleCenter">
            <size value="100px 30px"/>
            <textSize value="20px"/>
            <textBold value="true"/>
            <textAutoWidth value="true"/>
            <textSelectedOffset value="0px 15px"/>
            <textColor value="$preset_fs25_colorMainDark"/>
            <textSelectedColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <Profile name="fs25_shopItemsListItemTitleText" extends="fs25_textDarkHighlight" with="anchorBottomCenter">
            <size value="250px 20px"/>
            <position value="0px 144px"/>
            <textSize value="18px"/>
            <textBold value="true"/>
            <textAlignment value="center"/>
            <textLayoutMode value="scrolling"/>
            <textSelectedOffset value="0px 15px"/>
            <Variant name="mobile">
                <size value="520px 80px"/>
                <position value="0px 10px"/>
                <textBold value="true"/>
                <textSize value="40px"/>
                <textResizeWidth value="560px"/>
                <textWrapWidth value="1"/>
                <textColor value="$preset_colorWhite"/>
                <textSelectedColor value="$preset_colorWhite"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsListItemValueText" extends="fs25_textDarkHighlight" with="anchorBottomCenter">
            <size value="220px 30px"/>
            <position value="0px 80px"/>
            <textSize value="28px"/>
            <textAlignment value="center"/>
            <textSelectedOffset value="0px 15px"/>
            <Variant name="mobile">
                <visible value="false"/>
                <textBold value="true"/>
                <textSize value="40px"/>
                <textColor value="$preset_colorMainUI"/>
                <textSelectedColor value="$preset_colorMainUI"/>
                <textMaxNumLines value="1"/>
                <size value="560px 56px"/>
                <position value="0px 90px"/>
                <textBold value="false"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsListItemModDlcText" extends="fs25_shopListItemCategory" with="anchorBottomCenter">
            <size value="250px 16px"/>
            <position value="0px 117px"/>
            <textSize value="14px"/>
            <textUpperCase value="true"/>
            <textAlignment value="center"/>
            <textLayoutMode value="scrolling"/>
            <Variant name="mobile">
                <visible value="false"/>
            </Variant>
        </Profile>
        <Profile name="fs25_shopItemsDetailsInfoBox" extends="emptyPanel" with="anchorMiddleRight">
            <size value="800px 155px"/>
            <position value="-39px 0px"/>
            <numFlows value="4"/>
            <fitFlowToElements value="true"/>
            <Variant name="mobile" with="anchorTopCenter">
                <size value="1740px 150px"/>
                <position value="0px -10px"/>
            </Variant>
        </Profile>
    </GUIProfiles>
</GUI>
